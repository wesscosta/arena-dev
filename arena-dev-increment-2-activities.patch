+            "boolean"
+          ]
+        },
+        "expectedAnswer": {
+          "type": "string"
+        },
+        "explanation": {
+          "type": "string"
+        },
+        "code": {
+          "type": "string"
+        },
+        "language": {
+          "type": "string"
+        },
+        "expectedOutcome": {
+          "type": "string"
+        },
+        "evaluationCriteria": {
+          "type": "array",
+          "items": {
+            "type": "string",
