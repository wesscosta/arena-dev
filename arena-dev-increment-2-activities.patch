+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://arena.dev/schemas/question-package-v1.schema.json",
+  "title": "Arena Dev Question Package v1",
+  "type": "object",
+  "required": [
+    "version",
+    "questions"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "version": {
+      "const": "1.0"
+    },
+    "activity": {
+      "type": "object",
+      "additionalProperties": false,
+      "properties": {
+        "title": {
+          "type": "string"
