+.manual-options{display:flex;flex-direction:column;gap:6px}.manual-options label{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:8px}.manual-options label>span{width:24px;height:24px;border-radius:6px;background:var(--surface-3);display:grid;place-items:center;color:var(--accent);font-size:9px;font-weight:850}
