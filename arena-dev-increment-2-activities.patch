+      }
+    },
+    "questions": {
+      "type": "array",
+      "items": {
+        "$ref": "#/$defs/question"
+      }
+    }
+  },
+  "$defs": {
+    "difficulty": {
+      "enum": [
+        "EASY",
+        "INTERMEDIATE",
+        "HARD"
+      ]
+    },
+    "questionType": {
+      "enum": [
+        "MULTIPLE_CHOICE",
+        "OPEN",
+        "TRUE_FALSE",
+        "BUG_FIX",
+        "ANALYSIS",
+        "PRACTICAL",
+        "SCENARIO"
+      ]
+    },
+    "option": {
+      "type": "object",
+      "required": [
+        "id",
+        "text"
+      ],
+      "additionalProperties": false,
+      "properties": {
+        "id": {
+          "type": "string",
+          "minLength": 1
+        },
