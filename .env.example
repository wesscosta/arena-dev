# PostgreSQL
POSTGRES_DB=arena_dev
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena123
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
APP_FRONTEND_URL=http://localhost:3000
# Desenvolvimento em LAN: permite browsers na porta 3000. Em produção, restrinja aos hosts reais.
APP_ALLOWED_ORIGIN_PATTERNS=http://*:[3000]

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Professor (MVP)
APP_TEACHER_USERNAME=professor
APP_TEACHER_PASSWORD=troque-esta-senha

# Produção: use também `-f compose.prod.yaml`, HTTPS e valores longos/únicos.
# O perfil prod recusa variáveis ausentes e não publica o PostgreSQL.
