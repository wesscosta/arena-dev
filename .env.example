# PostgreSQL
POSTGRES_DB=arena_dev
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena123
POSTGRES_PORT=5432
# Development database listens on loopback only; 0.0.0.0 exposes it to the whole LAN.
POSTGRES_BIND=127.0.0.1

# Backend
BACKEND_PORT=8080
# Backend listens on loopback; LAN devices use the frontend (which proxies /api and /ws).
BACKEND_BIND=127.0.0.1
APP_FRONTEND_URL=http://localhost:3000
# Desenvolvimento em LAN: permite browsers na porta 3000. Em produção, restrinja aos hosts reais.
APP_ALLOWED_ORIGIN_PATTERNS=http://*:[3000]

# Frontend
FRONTEND_PORT=3000
# Classroom profile (scripts/arena.sh): interface where the frontend listens on the LAN.
FRONTEND_BIND=0.0.0.0
# Destino interno usado pelo proxy same-origin do Next.js no Docker.
INTERNAL_API_URL=http://backend:8080
# Produção pode apontar para uma API pública dedicada; em desenvolvimento local/loopback
# o browser usa a mesma origem do frontend e o Next.js encaminha /api e /ws internamente.
NEXT_PUBLIC_API_URL=http://localhost:8080
# fallback frontend; a apresentação principal agora é persistida por sessão no backend.
# valores aceitos: grid-spotlight | wheel (legacy-wheel ainda é aceito por compatibilidade)
NEXT_PUBLIC_ARENA_SELECTOR_MODE=grid-spotlight

# Professor (MVP)
APP_TEACHER_USERNAME=professor
APP_TEACHER_PASSWORD=troque-esta-senha
# Default idle time before the teacher must log in again (30-720); the teacher can change it in Configurações.
APP_TEACHER_SESSION_TIMEOUT_MINUTES=240

# Hardening de login (opcional; defaults seguros para instância single-teacher)
APP_LOGIN_RATE_LIMIT_MAX_FAILURES=5
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
APP_LOGIN_RATE_LIMIT_BLOCK_SECONDS=300

# v0.9 Learning Core — shadow/cutover evidence.
# Em execução de validação/release, mantenha os três shadows ativos para coletar equivalência.
APP_LEARNING_CORE_QUIZ_SHADOW_ENABLED=true
APP_LEARNING_CORE_POLL_SHADOW_ENABLED=true
APP_LEARNING_CORE_WORD_CLOUD_SHADOW_ENABLED=true
APP_LEARNING_CORE_CUTOVER_MINIMUM_TERMINAL_ROUNDS=3
APP_LEARNING_CORE_CUTOVER_SAMPLE_SIZE=200

# Produção: use também `-f compose.prod.yaml`, HTTPS e valores longos/únicos.
# O perfil prod recusa variáveis ausentes e não publica o PostgreSQL.

# Segredo dos ids opacos das alternativas (opcional). Vazio: a aplicação gera
# um segredo na primeira inicialização e o guarda no banco.
APP_ACTIVITY_OPTION_SECRET=

# AI-assisted grading (optional)
ARENA_AI_API_KEY=
ARENA_AI_MODEL=gpt-5.6-luna
ARENA_AI_BASE_URL=https://api.openai.com/v1


APP_INTEGRATIONS_MICROSOFT_CLIENT_SECRET=
APP_INTEGRATIONS_MICROSOFT_REDIRECT_URI=http://localhost:8080/api/integrations/microsoft/oauth/callback
APP_INTEGRATIONS_CREDENTIAL_ENCRYPTION_KEY=

# Microsoft 365 / Teams — OAuth delegado
# Registre o Arena Dev como Web App no Microsoft Entra ID.
APP_INTEGRATIONS_MICROSOFT_CLIENT_ID=
# Google Classroom — OAuth delegado
APP_INTEGRATIONS_GOOGLE_CLIENT_ID=
APP_INTEGRATIONS_GOOGLE_CLIENT_SECRET=
APP_INTEGRATIONS_GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/oauth/callback

# AES-256 em Base64. Gere com: openssl rand -base64 32

# Notion — leitura autorizada para importação de conteúdo
APP_INTEGRATIONS_NOTION_TOKEN=
APP_INTEGRATIONS_NOTION_API_VERSION=2022-06-28
APP_INTEGRATIONS_NOTION_BASE_URL=https://api.notion.com/v1
APP_INTEGRATIONS_NOTION_CLIENT_ID=
APP_INTEGRATIONS_NOTION_CLIENT_SECRET=
APP_INTEGRATIONS_NOTION_REDIRECT_URI=http://localhost:8080/api/integrations/notion/oauth/callback

# Operação em sala (scripts/arena.sh)
# Backups mantidos por "arena.sh backup/upgrade" (0 = não apaga nenhum).
BACKUP_KEEP=14
# HTTPS local opcional (Caddy com certificado próprio). Necessário para instalar a PWA nos celulares.
# ARENA_HOSTNAME é o nome ou IP que os aparelhos usam, ex.: 192.168.0.10 ou arena.lan.
ARENA_HTTPS=0
ARENA_HOSTNAME=
